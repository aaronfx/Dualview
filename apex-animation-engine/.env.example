# Copy to .env (never commit .env). Read by the backend only; never sent to the browser.
APEX_AI_PROVIDER=openrouter          # openrouter | openai | anthropic  (leave empty to use the offline template planner)
APEX_AI_MODEL=                       # empty = anthropic/claude-haiku-5.5 (low cost). Premium models also need APEX_AI_APPROVED_MODELS
APEX_AI_PAID_ENABLED=0               # 1 = allow paid calls (off by default)
APEX_AI_APPROVED_MODELS=             # owner-approved models beyond the low-cost list (comma-separated)
APEX_AI_MAX_CALLS=3                  # paid calls per experiment (caps repair retries)
APEX_AI_MAX_OUTPUT_TOKENS=6000       # output cap sent with each call
APEX_AI_REASONING_TOKENS=0           # hidden reasoning budget (billed as output); 0 = off
APEX_AI_EXPERIMENT_BUDGET_USD=0.10   # worst-case spend cap per experiment
APEX_AI_TOTAL_BUDGET_USD=1.00        # cumulative cap over the ledger
APEX_AI_LEDGER=./apex_data/ai_ledger.jsonl
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
APEX_AI_BASE_URL=                    # optional: any OpenAI-compatible endpoint
APEX_DATA_DIR=./apex_data            # SQLite DB + render outputs
APEX_RENDER_WORKERS=1
